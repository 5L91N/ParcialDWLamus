<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= receta.nombre %></title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      background: #f5f5f5;
      color: #333;
      line-height: 1.6;
    }
    header {
      background: #b71c1c;
      color: white;
      padding: 2rem;
      text-align: center;
    }
    main { max-width: 800px; margin: 2rem auto; padding: 0 1rem; }
    article {
      background: white;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      padding: 2rem;
    }
    section { margin-bottom: 2rem; }
    h2 { color: #b71c1c; margin-bottom: 1rem; font-size: 2rem; }
    h3 { color: #555; margin-bottom: 0.75rem; border-bottom: 2px solid #eee; padding-bottom: 0.25rem; }
    .meta { display: flex; gap: 2rem; margin-bottom: 1.5rem; }
    .meta p { background: #fce4ec; padding: 0.5rem 1rem; border-radius: 4px; }
    ul { list-style: none; }
    li {
      padding: 0.5rem 0;
      border-bottom: 1px dashed #ddd;
      display: flex;
      justify-content: space-between;
    }
    li:last-child { border-bottom: none; }
    .cantidad { font-weight: bold; color: #b71c1c; }
    footer {
      text-align: center;
      padding: 1.5rem;
      color: #888;
      font-size: 0.9rem;
    }
  </style>
</head>
<body>

  <header>
    <h1>Receta del Examen</h1>
  </header>

  <main>
    <article>
      <section>
        <h2><%= receta.nombre %></h2>
        <div class="meta">
          <p><strong>Cocina:</strong> <%= receta.tipoCocina %></p>
          <p><strong>Tiempo:</strong> <%= receta.tiempoPreparacion %></p>
        </div>
      </section>

      <section>
        <h3>Ingredientes</h3>
        <ul>
          <% receta.ingredientes.forEach(function(ing) { %>
            <li>
              <span><%= ing.nombre %></span>
              <span class="cantidad"><%= ing.cantidad %> <%= ing.unidad %></span>
            </li>
          <% }); %>
        </ul>
      </section>

      <% if (receta.origen) { %>
      <section>
        <h3>Origen</h3>
        <p><%= receta.origen.ciudad %>, <%= receta.origen.pais %></p>
      </section>
      <% } %>

    </article>
  </main>

  <footer>
    <p>Examen Parcial DB - Parte B</p>
  </footer>

</body>
</html>